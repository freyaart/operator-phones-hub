generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AvailabilityStatus {
  UNKNOWN
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
  DISCONTINUED
  BLOCKED
}

enum OfferType {
  RETAIL
  CONTRACT
  LOYALTY
  OTHER
}

enum ScrapeRunType {
  DISCOVER
  SYNC
}

enum ScrapeStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILURE
}

/// State of an `OperatorCatalogItem` relative to the canonical Reborn-first catalog.
enum MatchStatus {
  /// No canonical model could be linked yet.
  UNMATCHED
  /// Linked automatically by the matcher with high confidence.
  MATCHED_AUTO
  /// Linked manually by an operator (override / human review).
  MATCHED_MANUAL
  /// Auto-matcher returned a candidate but it requires human review.
  NEEDS_REVIEW
}

/// Canonical handset row. Now sourced from the Reborn catalog (see `RebornProduct`).
/// Operator-specific sellable variants live in `OperatorCatalogItem` and are linked by matching.
model PhoneModel {
  id            String   @id @default(cuid())
  brand         String
  /// Display name without storage / color, e.g. "iPhone 15 Pro" or "Galaxy S25".
  series        String
  marketingName String?
  releaseYear   Int?
  /// URL-safe canonical key without storage / color, e.g. "apple-iphone-15-pro".
  slug          String   @unique
  /// Where the canonical row originated; defaults to "reborn" under the Reborn-first model.
  source        String   @default("reborn")
  /// Structured technical data for comparison tables (see `PhoneTechnicalSpecs` in src).
  specs         Json?
  /// Non-technical metadata: internal SKUs, import source, Wave/Foxway ids, editorial notes.
  details       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  phoneSpec      PhoneSpec?
  rebornProducts RebornProduct[]
  catalogItems   OperatorCatalogItem[]
  offers         OperatorOffer[]   @relation("PhoneModelOffers")
  artifacts      ScrapeArtifact[]  @relation("PhoneModelArtifacts")

  @@index([brand, series])
  @@index([source])
}

/// Typed comparison data used by `/api/phones/compare`.
model PhoneSpec {
  id                       String    @id @default(cuid())
  phoneModelId             String    @unique
  phoneModel               PhoneModel @relation(fields: [phoneModelId], references: [id], onDelete: Cascade)
  market                   String?
  releaseYear              Int?
  heightMm                 Float?
  widthMm                  Float?
  depthMm                  Float?
  weightG                  Float?
  displayDiagonalInch      Float?
  displayWidthPx           Int?
  displayHeightPx          Int?
  displayResolutionLabel   String?
  displayAspectRatio       String?
  displayPanelType         String?
  displayRefreshRateHz     Int?
  displayTouchSamplingHz   Int?
  displayPeakBrightnessNits Int?
  displayHdr               String[]  @default([])
  displayProtection        String[]  @default([])
  displayAlwaysOn          Boolean?
  chipset                  String?
  cpu                      String?
  gpu                      String?
  ramGb                    Int?
  storageOptionsGb         Int[]     @default([])
  storageType              String?
  simSlots                 Int?
  esim                     Boolean?
  usb                      String?
  wifi                     String?
  bluetooth                String?
  nfc                      Boolean?
  uwb                      Boolean?
  satellite                String?
  rearCameraSummary        String?
  frontCameraSummary       String?
  videoSummary             String?
  stereoSpeakers           Boolean?
  headphoneJack            Boolean?
  batteryCapacityMah       Int?
  wiredChargeW             Int?
  wirelessChargeW          Int?
  reverseWireless          Boolean?
  os                       String?
  osVersionAtLaunch        String?
  updatePolicyYears        Int?
  cellular                 String?
  fiveG                    Boolean?
  fiveGBandsNote           String?
  frameMaterial            String?
  backMaterial             String?
  ipRating                 String?
  colors                   String[]  @default([])
  faceBiometrics           Boolean?
  fingerprint              String?
  extras                   Json?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

/// Operator-specific sellable item / PDP / listing reference.
/// Lives independently of the canonical catalog; linked to `PhoneModel` via the matcher.
model OperatorCatalogItem {
  id              String             @id @default(cuid())
  operator        String
  operatorItemKey String
  /// Nullable: operator items can exist before the matcher links them to a canonical model.
  phoneModelId    String?
  phoneModel      PhoneModel?        @relation(fields: [phoneModelId], references: [id], onDelete: SetNull)
  sourceUrl       String
  displayName     String
  variantLabel    String?
  color           String?
  storageGb       Int?
  availability    AvailabilityStatus @default(UNKNOWN)

  /// Brand parsed from the operator listing (used by the matcher and for review).
  parsedBrand     String?
  /// Model series parsed from the operator listing (without storage / color).
  parsedSeries    String?
  /// Canonical-style slug parsed from the operator listing.
  parsedSlug      String?
  matchStatus     MatchStatus        @default(UNMATCHED)
  matchConfidence Float?
  matchedAt       DateTime?
  matchedBy       String?

  discoveredAt    DateTime           @default(now())
  lastSeenAt      DateTime           @default(now())

  offers          OperatorOffer[]    @relation("CatalogItemOffers")
  artifacts       ScrapeArtifact[]   @relation("CatalogItemArtifacts")

  @@unique([operator, operatorItemKey])
  @@index([operator, phoneModelId])
  @@index([phoneModelId])
  @@index([matchStatus])
  @@index([parsedSlug])
}

/// One row per operator item + offer mode (retail, contract, loyalty, ...).
/// Always anchored to an `OperatorCatalogItem`; the canonical link is derived from the catalog item's match.
model OperatorOffer {
  id                   String             @id @default(cuid())
  /// Mirrors the matched canonical model on the parent catalog item; nullable when unmatched.
  phoneModelId         String?
  phoneModel           PhoneModel?        @relation("PhoneModelOffers", fields: [phoneModelId], references: [id], onDelete: SetNull)
  operatorCatalogItemId String
  operatorCatalogItem  OperatorCatalogItem @relation("CatalogItemOffers", fields: [operatorCatalogItemId], references: [id], onDelete: Cascade)
  /// a1 | telekom | t2 | telemach
  operator             String
  offerKey             String
  offerType            OfferType          @default(OTHER)
  title                String?
  retailPriceEur       Float?
  monthlyEur           Float?
  initialDepositEur    Float?
  contractMonths       Int?
  planLabel            String?
  tradeInAvailable     Boolean?
  availability         AvailabilityStatus @default(UNKNOWN)
  productUrl           String?
  /// Raw fragment from the page or API for debugging / re-parsing.
  raw                  Json?
  capturedAt           DateTime           @default(now())

  @@unique([operatorCatalogItemId, offerKey])
  @@index([phoneModelId, operator])
  @@index([operator])
}

/// Reborn catalog product imported from the Wave API.
/// Under the Reborn-first model these rows seed `PhoneModel`; each row is one Reborn
/// product (parent variant or color child). Storage/grade/color are parsed once on import.
model RebornProduct {
  id                  String    @id @default(cuid())
  phoneModelId        String
  phoneModel          PhoneModel @relation(fields: [phoneModelId], references: [id], onDelete: Cascade)
  productId           Int       @unique
  parentProductId     Int?
  isParent            Boolean   @default(false)
  isMatched           Boolean   @default(false)
  name                String?
  optionText          String?
  sku                 String?
  /// Parsed storage in GB (e.g. 128, 256), if recoverable from the Reborn name.
  storageGb           Int?
  /// Parsed color label (e.g. "Space Gray"), if available.
  color               String?
  /// Parsed condition grade ("A+", "A", "B", "C", ...) from the Reborn name.
  grade               String?
  priceEur            Float?
  oldPriceEur         Float?
  conditionStatus     String?
  foxwayItemVariantId String?
  purchaseStatus      Boolean?
  active              Boolean?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([phoneModelId])
  @@index([parentProductId])
}

model ScrapeRun {
  id             String        @id @default(cuid())
  operator       String
  runType        ScrapeRunType
  status         ScrapeStatus  @default(RUNNING)
  version        String?
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  processedCount Int           @default(0)
  successCount   Int           @default(0)
  failureCount   Int           @default(0)
  notes          String?
  metadata       Json?

  artifacts      ScrapeArtifact[] @relation("RunArtifacts")

  @@index([operator, runType, startedAt])
}

model ScrapeArtifact {
  id                  String              @id @default(cuid())
  scrapeRunId         String?
  scrapeRun           ScrapeRun?          @relation("RunArtifacts", fields: [scrapeRunId], references: [id], onDelete: SetNull)
  operator            String
  phoneModelId        String?
  phoneModel          PhoneModel?         @relation("PhoneModelArtifacts", fields: [phoneModelId], references: [id], onDelete: SetNull)
  operatorCatalogItemId String?
  operatorCatalogItem OperatorCatalogItem? @relation("CatalogItemArtifacts", fields: [operatorCatalogItemId], references: [id], onDelete: SetNull)
  artifactType        String
  sourceUrl           String?
  contentType         String?
  contentText         String?             @db.Text
  checksum            String?
  metadata            Json?
  createdAt           DateTime            @default(now())

  @@index([operator, artifactType, createdAt])
  @@index([phoneModelId])
  @@index([operatorCatalogItemId])
}
