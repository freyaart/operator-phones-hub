# Prisma loads `.env` by default (not `.env.local`). For CLI commands, either put DATABASE_URL in
# `.env` or run: `npx dotenv-cli -e .env.local -- npx prisma migrate deploy`
#
# Production / Neon / Vercel Postgres (sslmode often required):
DATABASE_URL=postgresql://user:pass@host.neon.tech/neondb?sslmode=require

# Local API
PORT=8787

# --- Operator sync (`npm run sync`) ---
# One-time: npm run playwright:install
# Stub only (no browser): SKIP_SCRAPE=1 npm run sync
# Watch browser: HEADFUL=1 npm run sync
# Optional PDP worker count:
# SYNC_PDP_CONCURRENCY=3
# Optional DB write worker count:
# SYNC_DB_CONCURRENCY=6
# Optional per-phone PDP overrides (JSON): details.shopUrls = { "telekom": "https://...", "a1": "...", "t2": "...", "telemach": "..." }
# Required Wave API base for Reborn canonical catalog sync:
# REBORN_WAVE_API_URL=https://api.wave.si
# Reborn sync runs separately or via bootstrap:
# npm run sync:reborn
# REBORN_SYNC_CONCURRENCY=5

# Import handset rows from operator listings (Telekom hash pages + A1 first listing page):
#   npm run discover
#   npm run discover -- --dry-run
#   npm run discover -- --sources=telekom
# Full resumable population:
#   npm run bootstrap:data
# Review unmatched rows after bootstrap:
#   npm run review:unmatched

# Scheduled job endpoints (`/api/jobs/*`) require this Authorization bearer token when set.
# CRON_SECRET=

# --- Vercel ---
# `vercel.json` uses `npm install --include=dev` so Prisma CLI + TypeScript are present.
# Set DATABASE_URL in the Vercel project environment (same Postgres URL as above).
