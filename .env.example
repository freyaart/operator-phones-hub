# SQLite (default). For PostgreSQL, switch datasource in prisma/schema.prisma and use e.g.:
# DATABASE_URL=postgresql://user:pass@localhost:5432/operator_phones
DATABASE_URL=file:./dev.db

# API
PORT=8787

# --- Vercel ---
# This app is Hono (not Next.js). `api/index.ts` + `vercel.json` deploy it as one serverless function.
# SQLite (file:./dev.db) is not suitable for production on Vercel (ephemeral filesystem). Use Postgres
# (Neon, Vercel Postgres, Supabase, …), set DATABASE_URL, then change `provider` in prisma/schema.prisma
# to "postgresql" and run migrations against that URL.
